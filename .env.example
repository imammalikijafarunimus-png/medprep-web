# ============================================
# MedPrep Web - Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your values
#.cp .env.example .env.local

# ============================================
# Firebase Configuration (Required)
# ============================================
# Get these values from Firebase Console:
# https://console.firebase.google.com/ > Project Settings > Your Apps

# Firebase API Key
VITE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain (usually: project-id.firebaseapp.com)
VITE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Project ID
VITE_PROJECT_ID=your_project_id_here

# Firebase Storage Bucket (usually: project-id.appspot.com)
VITE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Messaging Sender ID
VITE_MESSAGING_SENDER_ID=your_sender_id_here

# Firebase App ID
VITE_APP_ID=your_app_id_here

# ============================================
# Optional Configuration
# ============================================

# App Environment (development | production)
# VITE_APP_ENV=development

# Enable Debug Mode
# VITE_DEBUG=false

# ============================================
# Setup Instructions
# ============================================
# 1. Go to https://console.firebase.google.com/
# 2. Create a new project or select existing one
# 3. Enable Authentication:
#    - Go to Authentication > Sign-in method
#    - Enable Email/Password and Google
# 4. Create Firestore Database:
#    - Go to Firestore Database
#    - Create database (start in test mode)
# 5. Get configuration:
#    - Go to Project Settings (gear icon)
#    - Scroll to "Your apps" section
#    - Click on web app or create new one
#    - Copy the config values to this file
# 6. Rename this file to .env.local:
#    cp .env.example .env.local
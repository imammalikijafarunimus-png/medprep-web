// firestore.rules
// Role-based Firestore Security Rules with Custom Claims
// 
// Deploy: firebase deploy --only firestore:rules
//
// These rules use Firebase Custom Claims for role verification.
// Roles are set by Cloud Functions and stored in the ID token.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────
    
    /**
     * Check if user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Get user role from Custom Claims (server-side token)
     * Falls back to 'student' if not set
     */
    function getRole() {
      return request.auth.token.get('role', 'student');
    }

    /**
     * Check if user has student role or higher
     */
    function isStudent() {
      return isAuthenticated() && getRole() in ['student', 'admin', 'superadmin'];
    }

    /**
     * Check if user has admin role or higher
     */
    function isAdmin() {
      return isAuthenticated() && getRole() in ['admin', 'superadmin'];
    }

    /**
     * Check if user has superadmin role
     */
    function isSuperAdmin() {
      return isAuthenticated() && getRole() == 'superadmin';
    }

    /**
     * Check if user owns the document
     */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Validate that role field is not being modified by regular users
     */
    function roleNotModified() {
      return !('role' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ─── users/ collection ──────────────────────────────────────
    // User profile documents
    match /users/{userId} {
      // Anyone can read their own profile
      // Admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile on registration
      // Admin SDK (Cloud Functions) bypasses these rules
      allow create: if isOwner(userId);

      // Users can update their own profile, EXCEPT the 'role' field
      // Role changes must go through Cloud Functions
      allow update: if isOwner(userId) 
                    && !('role' in request.resource.data);
      
      // Only superadmin can delete users
      // Note: This doesn't delete the Auth user, just the Firestore doc
      allow delete: if isSuperAdmin();
    }

    // ─── audit_logs/ collection ─────────────────────────────────
    // Audit trail for role changes and security events
    match /audit_logs/{logId} {
      // Only superadmin can read audit logs
      allow read: if isSuperAdmin();
      
      // No client-side writes allowed
      // Only Cloud Functions (Admin SDK) can write
      allow write: if false;
    }

    // ─── questions/ collection ──────────────────────────────────
    // CBT question bank
    match /questions/{questionId} {
      // All authenticated users (students+) can read questions
      allow read: if isStudent();
      
      // Only admins can write questions
      allow write: if isAdmin();
    }

    // ─── osce_stations/ collection ──────────────────────────────
    // OSCE station data
    match /osce_stations/{stationId} {
      // All authenticated users can read OSCE stations
      allow read: if isStudent();
      
      // Only admins can write OSCE stations
      allow write: if isAdmin();
    }

    // ─── flashcards/ collection ─────────────────────────────────
    // Flashcard decks
    match /flashcards/{flashcardId} {
      // All authenticated users can read flashcards
      allow read: if isStudent();
      
      // Only admins can write flashcards
      allow write: if isAdmin();
    }

    // ─── user_progress/ collection ──────────────────────────────
    // User learning progress and statistics
    match /user_progress/{userId}/{document=**} {
      // Users can read/write their own progress
      // Admins can read all progress for analytics
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // ─── bookmarks/ collection ──────────────────────────────────
    // User bookmarks
    match /bookmarks/{bookmarkId} {
      // Users can only access their own bookmarks
      allow read, write: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // ─── subscriptions/ collection ──────────────────────────────
    // Subscription and payment data
    match /subscriptions/{userId} {
      // Users can read their own subscription status
      // Admins can read all subscriptions
      allow read: if isOwner(userId) || isAdmin();
      
      // No client-side writes
      // Only Cloud Functions (payment processing) can write
      allow write: if false;
    }

    // ─── system_config/ collection ──────────────────────────────
    // Application configuration
    match /system_config/{configId} {
      // All authenticated users can read config
      allow read: if isStudent();
      
      // Only superadmin can write config
      allow write: if isSuperAdmin();
    }

    // ─── announcements/ collection ──────────────────────────────
    // System announcements
    match /announcements/{announcementId} {
      // All authenticated users can read announcements
      allow read: if isStudent();
      
      // Only admins can write announcements
      allow write: if isAdmin();
    }

    // ─── feedback/ collection ───────────────────────────────────
    // User feedback and bug reports
    match /feedback/{feedbackId} {
      // Users can create feedback
      // Admins can read all feedback
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── sessions/ collection ───────────────────────────────────
    // CBTS session data
    match /sessions/{sessionId} {
      // Users can read their own sessions
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Users can create/update their own sessions
      allow create, update: if isOwner(request.resource.data.userId);
    }

    // ─── DEFAULT DENY ───────────────────────────────────────────
    // Explicitly deny access to any collection not covered above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
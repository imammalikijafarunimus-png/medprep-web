rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.get('role', 'student');
    }

    function isStudent() {
      return isAuthenticated() && getRole() in ['student', 'admin', 'superadmin'];
    }

    function isAdmin() {
      return isAuthenticated() && getRole() in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && getRole() == 'superadmin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }


    // ─────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────

    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId);

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['role','uid']);

      allow delete: if isSuperAdmin();
    }


    // ─────────────────────────────────────────
    // AUDIT LOGS
    // ─────────────────────────────────────────

    match /audit_logs/{logId} {

      allow read: if isSuperAdmin();

      // hanya backend / cloud functions
      allow write: if false;
    }


    // ─────────────────────────────────────────
    // CBT MATERIALS
    // ─────────────────────────────────────────

    match /cbt_materials/{materialId} {

      allow read: if isStudent();

      allow create, update, delete: if isAdmin();
    }


    // ─────────────────────────────────────────
    // CBT QUESTIONS
    // ─────────────────────────────────────────

    match /cbt_questions/{questionId} {

      allow read: if isStudent();

      allow create, update, delete: if isAdmin();
    }


    // ─────────────────────────────────────────
    // FLASHCARDS
    // ─────────────────────────────────────────

    match /flashcards/{flashcardId} {

      allow read: if isStudent();

      allow create, update, delete: if isAdmin();
    }


    // ─────────────────────────────────────────
    // GENERAL QUESTION BANK
    // ─────────────────────────────────────────

    match /questions/{questionId} {

      allow read: if isStudent();

      allow create, update, delete: if isAdmin();
    }


    // ─────────────────────────────────────────
    // OSCE STATIONS
    // ─────────────────────────────────────────

    match /osce_stations/{stationId} {

      allow read: if isStudent();

      allow create, update, delete: if isAdmin();
    }


    // ─────────────────────────────────────────
    // USER PROGRESS
    // ─────────────────────────────────────────

    match /user_progress/{userId}/{document=**} {

      allow read, write: if isOwner(userId) || isAdmin();
    }


    // ─────────────────────────────────────────
    // SUBSCRIPTIONS
    // ─────────────────────────────────────────

    match /subscriptions/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      // hanya backend
      allow write: if false;
    }


    // ─────────────────────────────────────────
    // DEFAULT DENY
    // ─────────────────────────────────────────

    match /{document=**} {

      allow read, write: if false;

    }

  }
}